# PostgreSQL connection string (Railway provee DATABASE_URL automáticamente)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secreto para firmar JWT — usa un string largo y aleatorio
JWT_SECRET=cambia_esto_por_algo_muy_secreto_y_largo

# Entorno
NODE_ENV=production

# URL del frontend (para CORS en desarrollo)
FRONTEND_URL=http://localhost:5173
